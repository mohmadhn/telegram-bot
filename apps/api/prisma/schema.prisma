generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ACCOUNTANT") // ADMIN, ACCOUNTANT, SALESPERSON, WAREHOUSE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id              String    @id @default(uuid())
  name            String
  contactInfo     String?
  balance         Float     @default(0.0)
  totalPurchases  Float     @default(0.0)
  lastTransaction DateTime?
  invoices        Invoice[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Supplier {
  id              String    @id @default(uuid())
  name            String
  contactInfo     String?
  balance         Float     @default(0.0)
  totalSales      Float     @default(0.0)
  lastTransaction DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  category    String
  unit        String   // KG, TON, PIECE
  price       Float
  stockLevel  Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id            String   @id @default(uuid())
  type          String   // PURCHASE or SALE
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  totalAmount   Float
  discount      Float    @default(0.0)
  netAmount     Float
  status        String   @default("DRAFT") // DRAFT, FINALIZED, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
